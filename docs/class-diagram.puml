@startuml
title EXINS Database Tables and StoreContext Operations
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho

class "auth.users" as AuthUsers <<Supabase Auth>> {
  id: uuid
}

class "public.users" as Users <<table>> {
  id: text
  uid: text
  email: text
  display_name: text
  role: text
  phone: text
  address: text
  provider: text
  is_guest: boolean
  created_at: timestamptz
  --
  +signupAs()
  +loginAs()
  +completeGoogleSignUp()
  +logout()
}

class "public.bales" as Bales <<table>> {
  id: text
  bale_code: text
  bale_name: text
  category: text
  supplier_id: text
  supplier_name: text
  total_purchase_price: numeric
  quantity_purchase: numeric
  price_per_piece: numeric
  description: text
  status: text
  total_sales_made: numeric
  created_at: timestamptz
  --
  +addBale()
  +updateBale()
  +deleteBale()
}

class "public.categories" as Categories <<table>> {
  id: text
  name: text
  description: text
  color: text
  total_in_stock: numeric
  created_at: timestamptz
  --
  +addCategory()
  +updateCategory()
  +deleteCategory()
}

class "public.products" as Products <<table>> {
  id: text
  name: text
  category: text
  bale_code: text
  bale_name: text
  available_quantity: numeric
  selling_price: numeric
  cost_price: numeric
  size: text
  image_url: text
  product_link: text
  description: text
  barcode: text
  created_at: timestamptz
  --
  +addProduct()
  +updateProduct()
  +deleteProduct()
}

class "public.suppliers" as Suppliers <<table>> {
  id: text
  name: text
  contact_person: text
  email: text
  phone: text
  address: text
  description: text
  total_bales_sourced: numeric
  created_at: timestamptz
  --
  +addSupplier()
  +updateSupplier()
  +deleteSupplier()
}

class "public.expense_accounts" as ExpenseAccounts <<table>> {
  id: text
  name: text
  monthly_budget: numeric
  description: text
  total_spent: numeric
  color: text
  created_at: timestamptz
  --
  +addExpenseAccount()
  +updateExpenseAccount()
  +deleteExpenseAccount()
}

class "public.expenses" as Expenses <<table>> {
  id: text
  account_id: text
  account_name: text
  amount: numeric
  date: text
  payment_method: text
  receipt_url: text
  description: text
  created_at: timestamptz
  --
  +addExpense()
  +deleteExpense()
}

class "public.orders" as Orders <<table>> {
  id: text
  order_number: text
  customer_name: text
  items: jsonb
  total_amount: numeric
  status: text
  discount: numeric
  amount_tendered: numeric
  change_amount: numeric
  payment_method: text
  created_at: timestamptz
  updated_at: timestamptz
  --
  +completePosSale()
  +normalizeOrder()
  +exins_sync_customer_purchase()
}

class "public.transactions" as Transactions <<table>> {
  id: text
  date: text
  flow_type: text
  category: text
  account: text
  description: text
  payment_method: text
  inflow: numeric
  outflow: numeric
  order_id: text
  expense_id: text
  created_at: timestamptz
  --
  +addTransaction()
  +deleteTransaction()
}

class "public.customers" as Customers <<table>> {
  id: text
  customer_name: text
  total_purchase: numeric
}

class "public.item_logs" as ItemLogs <<table>> {
  id: text
  product_id: text
  product_name: text
  type: text
  quantity: numeric
  date: text
  notes: text
  created_at: timestamptz
  status: text
  found_quantity: numeric
  found_date: text
  found_notes: text
  --
  +logItemStatus()
  +updateItemStatusLog()
  +deleteItemStatusLog()
}

class "public.exbin_trash" as ExbinTrash <<table>> {
  id: uuid
  table_name: text
  record_id: text
  record_data: jsonb
  deleted_by: uuid
  deleted_at: timestamptz
  expires_at: timestamptz
  --
  +moveRecordsToTrash()
  +fetchTrashItems()
  +restoreTrashItems()
  +exins_purge_expired_trash()
}

class "public.exbin_archive" as ExbinArchive <<table>> {
  archive_id: bigint
  trash_id: text
  table_name: text
  record_id: text
  record_data: jsonb
  deleted_at: timestamptz
  expires_at: timestamptz
  archived_at: timestamptz
}

class "public.audit_logs" as AuditLogs <<table>> {
  id: bigint
  table_name: text
  record_id: text
  action: text
  actor_id: uuid
  actor_name: text
  actor_email: text
  actor_role: text
  occurred_at: timestamptz
  --
  +capture_status_log()
}

Suppliers ..> Bales : supplier_id
Categories ..> Bales : category
Categories ..> Products : category
Bales ..> Products : bale_code
Products ..> ItemLogs : product_id
ExpenseAccounts ..> Expenses : account_id
Orders ..> Transactions : order_id
Expenses ..> Transactions : expense_id
Products ..> Orders : items jsonb snapshots
Orders ..> Customers : purchase summary trigger
Users ..> AuthUsers : uid
AuditLogs ..> AuthUsers : actor_id
ExbinTrash "0..*" --> "1" AuthUsers : deleted_by FK

note bottom of ExbinTrash
  PKs, the unique users.uid and exbin_archive.trash_id,
  NOT NULL/default/CHECK constraints match the supplied SQL.
  Dashed links are logical references; deleted_by is the
  foreign key. items is JSONB, not a separate table.
end note
@enduml
