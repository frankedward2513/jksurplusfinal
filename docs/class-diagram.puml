@startuml EXINS_Class_Diagram
title EXINS - Application and Data Model
top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Identity" {
  class AuthUser <<Supabase Auth>> {
    +id: UUID
    +email: string
  }
  class UserProfile <<TypeScript model>> {
    +uid: string
    +email: string
    +displayName: string
    +role: UserRole
  }
  enum UserRole {
    owner
    staff
    customer
    guest
  }
  class "public.users" as PublicUsers <<table>> {
    +id: text <<PK>>
    +uid: text <<unique>>
    +role: text
  }
}

package "Inventory and sales" {
  class Supplier {
    +id: string
    +name: string
  }
  class Category {
    +id: string
    +name: string
  }
  class Bale {
    +id: string
    +baleCode: string
    +supplierId: string
    +status: BaleStatus
  }
  enum BaleStatus {
    sealed
    opened
    depleted
  }
  class Product {
    +id: string
    +category: string
    +baleCode: string
    +availableQuantity: number
  }
  class Order {
    +id: string
    +orderNumber: string
    +customerName: string
    +items: OrderItem[]
    +totalAmount: number
    +status: OrderStatus
  }
  class OrderItem <<orders.items JSONB>> {
    +productId: string
    +quantity: number
    +price: number
  }
  enum OrderStatus {
    pending
    preparing
    dropped_to_courier
    completed
    cancelled
  }
  class CustomerSummary {
    +id: string
    +customerName: string
    +totalPurchase: number
  }
}

package "Finance and item history" {
  enum PaymentMethod {
    cash
    gcash
    bank_transfer
    card
  }
  class ExpenseAccount {
    +id: string
    +name: string
  }
  class Expense {
    +id: string
    +accountId: string
    +amount: number
    +paymentMethod: PaymentMethod
  }
  class Transaction {
    +id: string
    +flowType: FlowType
    +orderId: string?
    +expenseId: string?
  }
  enum FlowType {
    inflow
    outflow
  }
  class ItemStatusLog {
    +id: string
    +productId: string
    +type: ItemStatusType
    +status: ItemResolutionStatus?
  }
  enum ItemStatusType {
    sold
    returned
    damaged
    lost
  }
  enum ItemResolutionStatus {
    lost
    found
    resolved
  }
}

package "System records" {
  class TrashItem <<StoreContext projection>> {
    +id: string
    +tableName: string
    +recordId: string
    +expiresAt: string
  }
  class "public.exbin_trash" as ExbinTrash <<table>> {
    +id: UUID <<PK>>
    +record_data: jsonb
    +deleted_by: UUID <<FK>>
    +expires_at: timestamptz
  }
  class "public.audit_logs" as AuditLogs <<optional table>> {
    +id: bigint <<PK>>
    +table_name: text
    +actor_role: text
  }
}

package "Application state and persistence" {
  interface StoreContextType {
    +isDarkMode: boolean
    +currentUser: UserProfile
    +customers: CustomerSummary[]
    +bales: Bale[]
    +categories: Category[]
    +products: Product[]
    +suppliers: Supplier[]
    +expenseAccounts: ExpenseAccount[]
    +expenses: Expense[]
    +orders: Order[]
    +transactions: Transaction[]
    +itemStatusLogs: ItemStatusLog[]
    +formAlert: string?
    +formAlertType: FormAlertType
    +toggleDarkMode()
    +loginAs()
    +signupAs()
    +loginWithGoogleFast()
    +completeGoogleSignUp()
    +logout()
    +addBale()
    +updateBale()
    +deleteBale()
    +addCategory()
    +updateCategory()
    +deleteCategory()
    +addProduct()
    +updateProduct()
    +deleteProduct()
    +addSupplier()
    +updateSupplier()
    +deleteSupplier()
    +addExpenseAccount()
    +updateExpenseAccount()
    +deleteExpenseAccount()
    +addExpense()
    +deleteExpense()
    +addTransaction()
    +deleteTransaction()
    +completePosSale()
    +logItemStatus()
    +updateItemStatusLog()
    +deleteItemStatusLog()
    +fetchTrashItems()
    +restoreTrashItems()
  }
  enum FormAlertType {
    success
    error
    info
  }
  class StoreProvider <<React component>>
  class StoreContext <<React Context>>
  class StoreHooks <<React module>> {
    +useStore(): StoreContextType
  }
  class SupabaseDataAccess <<module>> {
    +setDoc()
    +updateDoc()
    +deleteDoc()
    +onSnapshot()
    -readTable()
  }
  class SupabaseClient <<external service>>
}

UserProfile --> UserRole
AuthUser ..> UserProfile : authenticated identity
UserProfile ..> PublicUsers : signup profile
Supplier "1" ..> "0..*" Bale : supplierId, logical
Category "1" ..> "0..*" Bale : category, logical
Category "1" ..> "0..*" Product : category, logical
Bale "1" ..> "0..*" Product : baleCode, logical
Product "1" ..> "0..*" ItemStatusLog : productId, logical
Order "1" *-- "0..*" OrderItem : JSONB items
ExpenseAccount "1" ..> "0..*" Expense : accountId, logical
Order "0..1" ..> "0..*" Transaction : orderId, logical
Expense "0..1" ..> "0..*" Transaction : expenseId, logical
CustomerSummary "0..1" ..> "0..*" Order : customerName
AuthUser "1" -- "0..*" ExbinTrash : deleted_by FK
ExbinTrash ..> TrashItem : selected fields

StoreProvider --> StoreContext : provides value
StoreContext ..> StoreContextType : value shape
StoreHooks ..> StoreContextType : returns
StoreProvider o-- "0..*" Product
StoreProvider o-- "0..*" Category
StoreProvider o-- "0..*" Bale
StoreProvider o-- "0..*" Supplier
StoreProvider o-- "0..*" Order
StoreProvider o-- "0..*" ExpenseAccount
StoreProvider o-- "0..*" Expense
StoreProvider o-- "0..*" Transaction
StoreProvider o-- "0..*" ItemStatusLog
StoreProvider o-- "0..*" CustomerSummary
StoreProvider ..> SupabaseDataAccess
SupabaseDataAccess --> SupabaseClient
StoreProvider ..> ExbinTrash : trash and restore RPCs

note bottom of UserProfile
  Representative attributes only.
  Guest is app-only. Other data links are logical, not
  SQL foreign keys, except exbin_trash.deleted_by.
end note
note bottom of OrderItem
  Embedded JSONB value, not a separate table.
end note
note bottom of AuditLogs
  Optional SQL feature; SQL allows admin/staff, while
  the application uses owner/staff.
end note
@enduml
