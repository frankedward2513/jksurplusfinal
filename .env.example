# Template only; use a server-side environment variable or local .env file.
# Never put real API keys in this file or commit them.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Public URL where this app is deployed.
APP_URL="http://localhost:3000"

# Public Supabase settings used by the browser build. Use a publishable/anon key only.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Existing Vercel projects may also use these supported public variable names:
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
