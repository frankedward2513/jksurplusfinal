@startuml
title EXINS Web Application Class Diagram
top to bottom direction
skinparam backgroundColor #111111
skinparam classBackgroundColor white
skinparam classFontColor black
skinparam classBorderColor white
skinparam ArrowColor white
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55

package "Users and application" {
  abstract class UserProfile {
    +uid: string
    +email: string
    +displayName: string
    +role: UserRole
  }

  class Owner <<role>>
  class Staff <<role>>
  class Customer <<role>>
  class Guest <<role>>

  enum UserRole {
    owner
    staff
    customer
    guest
  }

  class App {
    +render(): ReactElement
  }

  class MainLayout {
    -activeTab: string
    -isAuthModalOpen: boolean
    +handleOpenAuth(): void
    +render(): ReactElement
  }

  class StoreProvider {
    +currentUser: UserProfile
    +products: Product[]
    +categories: Category[]
    +bales: Bale[]
    +suppliers: Supplier[]
    +orders: Order[]
    +expenseAccounts: ExpenseAccount[]
    +expenses: Expense[]
    +transactions: Transaction[]
    +itemStatusLogs: ItemStatusLog[]
    +customers: CustomerSummary[]
    +isDarkMode: boolean
    +loginAs(email: string, password: string): Promise<boolean>
    +signupAs(params: object): Promise<string>
    +logout(): Promise<void>
    +addProduct(product: Product): Promise<void>
    +updateProduct(id: string, updates: object): Promise<void>
    +deleteProduct(id: string): Promise<void>
    +completePosSale(params: object): Promise<Order>
    +addExpense(expense: Expense): Promise<void>
    +logItemStatus(params: object): Promise<void>
    +fetchTrashItems(): Promise<TrashItem[]>
    +restoreTrashItems(ids: string[]): Promise<void>
  }

  class Navbar {
    +activeTab: string
    +onSelectTab(tab: string): void
    +render(): ReactElement
  }

  class DashboardView {
    +render(): ReactElement
  }

  class InventoryManagementView {
    +render(): ReactElement
  }

  class PosView {
    +render(): ReactElement
  }

  class FinanceManagementView {
    +render(): ReactElement
  }

  class ShowcaseShopView {
    +render(): ReactElement
  }

  class ForecastingView {
    +render(): ReactElement
  }

  class AiChatbotView {
    +render(): ReactElement
  }

  class ReceiptsView {
    +render(): ReactElement
  }

  class TrashBinView {
    +render(): ReactElement
  }

  class ActivityLogView {
    +render(): ReactElement
  }

  class AuthModal {
    -isOpen: boolean
    +onClose(): void
    +render(): ReactElement
  }
}

package "Inventory and sales" {
  class Product {
    +id: string
    +name: string
    +category: string
    +baleCode: string
    +availableQuantity: number
    +sellingPrice: number
  }

  class Category {
    +id: string
    +name: string
    +totalInStock: number
  }

  class Bale {
    +id: string
    +baleCode: string
    +supplierId: string
    +quantityPurchase: number
    +pricePerPiece: number
  }

  class Supplier {
    +id: string
    +name: string
    +contactPerson: string
    +phone: string
  }

  class Order {
    +id: string
    +orderNumber: string
    +customerName: string
    +items: OrderItem[]
    +totalAmount: number
    +status: OrderStatus
  }

  class OrderItem {
    +productId: string
    +name: string
    +quantity: number
    +price: number
  }

  enum OrderStatus {
    pending
    preparing
    completed
    cancelled
  }
}

package "Finance and inventory history" {
  class Expense {
    +id: string
    +accountId: string
    +amount: number
    +date: string
  }

  class ExpenseAccount {
    +id: string
    +name: string
    +monthlyBudget: number
    +totalSpent: number
  }

  class Transaction {
    +id: string
    +flowType: FlowType
    +inflow: number
    +outflow: number
    +orderId: string?
    +expenseId: string?
  }

  enum FlowType {
    inflow
    outflow
  }

  class ItemStatusLog {
    +id: string
    +productId: string
    +type: ItemStatusType
    +quantity: number
    +status: string?
  }

  enum ItemStatusType {
    sold
    returned
    damaged
    lost
  }

  class CustomerSummary {
    +id: string
    +customerName: string
    +totalPurchase: number
  }

  class TrashItem {
    +id: string
    +tableName: string
    +recordId: string
    +expiresAt: string
  }
}

package "External services" {
  class SupabaseAdapter {
    +setDoc(ref: object, data: object): Promise<void>
    +updateDoc(ref: object, updates: object): Promise<void>
    +deleteDoc(ref: object): Promise<void>
    +onSnapshot(ref: object, callback: Function): Function
    -readTable(tableName: string): Promise<object[]>
  }

  class GeminiHandler {
    +handleGeminiRequest(payload: unknown): Promise<object>
  }

  class Supabase <<external service>>
  class GeminiAPI <<external service>>
}

UserProfile <|-- Owner
UserProfile <|-- Staff
UserProfile <|-- Customer
UserProfile <|-- Guest
UserProfile "0..*" --> "1" UserRole : has role

App "1" *-- "1" StoreProvider
StoreProvider "1" *-- "1" MainLayout
MainLayout "1" *-- "1" Navbar
MainLayout "1" *-- "0..1" DashboardView : owner
MainLayout "1" *-- "0..1" InventoryManagementView : owner or staff
MainLayout "1" *-- "0..1" PosView : owner or staff
MainLayout "1" *-- "0..1" FinanceManagementView : owner
MainLayout "1" *-- "0..1" ShowcaseShopView : customer or guest
MainLayout "1" *-- "0..1" ForecastingView : owner
MainLayout "1" *-- "0..1" AiChatbotView : owner
MainLayout "1" *-- "0..1" ReceiptsView : owner or staff
MainLayout "1" *-- "0..1" TrashBinView : owner
MainLayout "1" *-- "0..1" ActivityLogView : owner
MainLayout "1" *-- "1" AuthModal : authentication

DashboardView ..> StoreProvider
InventoryManagementView ..> StoreProvider
PosView ..> StoreProvider
FinanceManagementView ..> StoreProvider
ShowcaseShopView ..> StoreProvider
ForecastingView ..> StoreProvider
AiChatbotView ..> StoreProvider
ReceiptsView ..> StoreProvider
TrashBinView ..> StoreProvider
ActivityLogView ..> StoreProvider

StoreProvider "1" --> "1" UserProfile : current session
StoreProvider "1" o-- "0..*" Product
StoreProvider "1" o-- "0..*" Category
StoreProvider "1" o-- "0..*" Bale
StoreProvider "1" o-- "0..*" Supplier
StoreProvider "1" o-- "0..*" Order
StoreProvider "1" o-- "0..*" ExpenseAccount
StoreProvider "1" o-- "0..*" Expense
StoreProvider "1" o-- "0..*" Transaction
StoreProvider "1" o-- "0..*" ItemStatusLog
StoreProvider "1" o-- "0..*" CustomerSummary
StoreProvider "1" o-- "0..*" TrashItem

Category "1" <-- "0..*" Product : classifies
Bale "1" <-- "0..*" Product : stocks
Supplier "1" <-- "0..*" Bale : supplies
Order "1" *-- "0..*" OrderItem : contains
Product "1" <-- "0..*" OrderItem : product snapshot
ExpenseAccount "1" <-- "0..*" Expense : records
Order "0..1" <-- "0..*" Transaction : sale reference
Expense "0..1" <-- "0..*" Transaction : expense reference
Product "1" <-- "0..*" ItemStatusLog : status history
CustomerSummary "0..1" <-- "0..*" Order : purchase summary

StoreProvider --> SupabaseAdapter : reads and writes
SupabaseAdapter --> Supabase : database and authentication
AiChatbotView --> GeminiHandler : asks shop questions
GeminiHandler --> GeminiAPI : generates answers

note right of UserProfile
  Owner, Staff, Customer, and Guest are conceptual role
  specializations. The implementation uses one UserProfile
  with a UserRole value, not separate role classes.
end note

note bottom of Transaction
  + public, - private, # protected, ~ package.
  Protected/package members are not used in this application.
  0..* means zero or many; 1..* means one or many.
  Domain links are logical references, not database foreign keys.
end note
@enduml
