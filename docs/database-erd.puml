@startuml
title EXINS Supabase Database ER Diagram
left to right direction
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor #444444
}

entity "auth.users" as auth_users {
  * id : uuid <<PK>>
}

entity "public.users" as users {
  id <<UK>>
  --
  uid
  email
  display_name
  role
  is_guest
  phone
  address
  provider
  created_at
}

entity "public.suppliers" as suppliers {
  id <<UK>>
  --
  name
  contact_person
  email
  phone
  address
  description
  total_bales_sourced
  created_at
}

entity "public.categories" as categories {
  id <<UK>>
  --
  name
  description
  color
  total_in_stock
  created_at
}

entity "public.bales" as bales {
  id <<UK>>
  --
  bale_code
  bale_name
  category
  supplier_id
  supplier_name
  total_purchase_price
  quantity_purchase
  price_per_piece
  description
  status
  total_sales_made
  created_at
}

entity "public.products" as products {
  id <<UK>>
  --
  name
  category
  bale_code
  bale_name
  available_quantity
  selling_price
  cost_price
  size
  image_url
  product_link
  description
  barcode
  created_at
}

entity "public.item_logs" as item_logs {
  id <<UK>>
  --
  product_id
  product_name
  type
  quantity
  date
  notes
  created_at
  status
  found_quantity
  found_date
  found_notes
}

entity "public.customers" as customers {
  id
  --
  customer_name
  total_purchase
}

entity "public.orders" as orders {
  id <<UK>>
  --
  order_number
  customer_name
  items : JSON array
  total_amount
  status
  discount
  amount_tendered
  change_amount
  payment_method
  created_at
  updated_at
}

entity "public.expense_accounts" as expense_accounts {
  id <<UK>>
  --
  name
  monthly_budget
  description
  total_spent
  color
  created_at
}

entity "public.expenses" as expenses {
  id <<UK>>
  --
  account_id
  account_name
  amount
  date
  payment_method
  receipt_url
  description
  created_at
}

entity "public.transactions" as transactions {
  id <<UK>>
  --
  date
  flow_type
  category
  account
  description
  payment_method
  inflow
  outflow
  order_id
  expense_id
  created_at
}

entity "public.audit_logs" as audit_logs {
  * id : bigint <<PK>>
  --
  table_name : text
  record_id : text
  action : text
  actor_id : uuid
  actor_name : text
  actor_email : text
  actor_role : text
  occurred_at : timestamptz
}

entity "public.exbin_trash" as exbin_trash {
  id
  --
  table_name
  record_id
  record_data : JSON
  deleted_at
  expires_at
}

users ..> auth_users : uid references id
audit_logs ..> auth_users : actor_id references id
bales ..> suppliers : supplier_id references id
bales ..> categories : category references name
products ..> categories : category references name
products ..> bales : bale_code references bale_code
item_logs ..> products : product_id references id
expenses ..> expense_accounts : account_id references id
transactions ..> orders : order_id references id
transactions ..> expenses : expense_id references id
orders ..> products : product_id inside items JSON

note right of orders
  items is an embedded JSON array of
  sale-time product snapshots. There
  is no separate order_items table.
end note

note bottom of customers
  Customer purchase summaries are
  aggregated by customer name.
  Orders do not store a customer_id.
end note

note bottom of exbin_trash
  table_name and record_id identify
  a soft-deleted source record.
  This is a polymorphic reference.
end note

note right of audit_logs
  Included migration declares id as
  an identity primary key. action is
  limited to INSERT, UPDATE, DELETE,
  SALE, LOST, or FOUND. actor_role is
  limited to admin or staff.
end note

note bottom of transactions
  Dashed arrows show app-level references
  documented in README.md. The README says
  the current schema has no foreign keys.
  UK marks the id used by application upserts;
  only audit_logs PK is confirmed by checked-in
  SQL. App-table types, nullability, and defaults
  are omitted because base schema SQL is absent.
end note
@enduml
